# CineScope Environment Configuration

# Server-Side Only: TMDB Read Access Bearer Token (Never exposed to the browser)
# Used by Vercel Serverless Functions in api/*
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Client-Side Configuration (Optional)
# Base URL for the internal serverless API proxy (Defaults to /api)
VITE_API_BASE_URL=/api

# Set to 'true' to force mock mode even if server API is configured
VITE_USE_MOCK_DATA=false
